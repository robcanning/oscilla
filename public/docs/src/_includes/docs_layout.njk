<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "Oscilla Documentation" }}</title>
  <link rel="stylesheet" href="{{ '/docs/style.css' | url }}">
  <link rel="icon" type="image/svg+xml" href="{{ '/docs/favicon.svg' | url }}">

</head>

<body>

  <!-- Mobile overlay (closes sidebar when tapped) -->
  <div class="sidebar-overlay" aria-hidden="true"></div>

  <header class="docs-header">
    <button class="docs-menu-toggle" aria-label="Toggle menu" aria-expanded="false">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
      <a href="{{ '/docs/' | url }}" class="docs-brand">
        <img
          src="{{ '/docs/img/logos/logo-header-docs.svg' | url }}"
          alt="Oscilla"
          class="docs-logo"
          aria-hidden="true"
        >
      </a>

            <nav class="docs-nav" aria-label="Page navigation">
        <a id="docs-prev" href="#">← Previous</a>
        <a id="docs-next" href="#">Next →</a>
      </nav>
  </header>

  <div class="docs-container">
    {% include "sidebar.njk" %}
    
    <main class="docs-content">

      
      {{ content | safe }}
      
      <p class="docs-hint">Tip: use ← → or ↑ ↓ to navigate the docs</p>
    </main>
  </div>

  <script>

document.addEventListener('click', (e) => {
  const link = e.target.closest('a.popup-link');
  if (link) {
    e.preventDefault();
    window.open(
      link.href,
      'cheatsheet',
      'width=1200,height=800,menubar=no,toolbar=no,location=no,status=no'
    );
  }
});

  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.querySelector(".docs-menu-toggle");
    const overlay = document.querySelector(".sidebar-overlay");
    const sidebar = document.querySelector(".sidebar");
    
    function toggleSidebar() {
      const isOpen = document.body.classList.toggle("sidebar-open");
      btn?.setAttribute("aria-expanded", isOpen);
    }
    
    function closeSidebar() {
      document.body.classList.remove("sidebar-open");
      btn?.setAttribute("aria-expanded", "false");
    }
    
    btn?.addEventListener("click", toggleSidebar);
    overlay?.addEventListener("click", closeSidebar);
    
    // Close sidebar on escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && document.body.classList.contains("sidebar-open")) {
        closeSidebar();
      }
    });
    
    // Close sidebar when clicking a link (mobile)
    sidebar?.addEventListener("click", (e) => {
      if (e.target.tagName === "A" && window.innerWidth <= 900) {
        closeSidebar();
      }
    });
  });

  // Sidebar-ordered prev/next navigation
  (function () {
    const sidebar = document.querySelector(".sidebar");
    if (!sidebar) return;

    const links = Array.from(sidebar.querySelectorAll("a[href]")).map(a => a.href);
    const current = window.location.href.replace(/#.*$/, "");
    const index = links.findIndex(href => href === current);

    const prev = index > 0 ? links[index - 1] : null;
    const next = index >= 0 && index < links.length - 1 ? links[index + 1] : null;

    const prevBtn = document.getElementById("docs-prev");
    const nextBtn = document.getElementById("docs-next");

    if (prevBtn) {
      if (prev) prevBtn.href = prev;
      else prevBtn.style.visibility = "hidden";
    }

    if (nextBtn) {
      if (next) nextBtn.href = next;
      else nextBtn.style.visibility = "hidden";
    }

    // Mark current page in sidebar
    sidebar.querySelectorAll("a[href]").forEach(a => {
      if (a.href === current) {
        a.classList.add("active");
        a.setAttribute("aria-current", "page");
      }
    });

    // Keyboard navigation
    document.addEventListener("keydown", e => {
      if (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA") return;

      if ((e.key === "ArrowLeft" || e.key === "ArrowUp") && prev) {
        window.location.href = prev;
      }
      if ((e.key === "ArrowRight" || e.key === "ArrowDown") && next) {
        window.location.href = next;
      }
    });
  })();
  </script>

</body>
</html>
