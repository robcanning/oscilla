{
  "name": "oscilla",
  "version": "0.4.2",
  "description": "Oscilla — networked animated score system",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "bundle": "esbuild server.js --bundle --platform=node --format=cjs --outfile=server.cjs --packages=external",
    "build": "./build/build.sh"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "chevrotain": "^11.0.3",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "osc": "^2.4.5",
    "pm2": "^6.0.10",
    "svg-path-commander": "^2.1.10",
    "svgo": "^3.3.2",
    "unzipper": "^0.12.3",
    "ws": "^8.18.0",
    "xml-js": "^1.6.11",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.12.0",
    "esbuild": "^0.25.0",
    "vite": "^6.3.5"
  },
  "pkg": {
    "scripts": [],
    "assets": [
      "VERSION",
      "public/**/*",
      "scores/template/**/*",
      "scores/helper-score/**/*"
    ],
    "targets": [
      "node20-linux-x64",
      "node20-macos-x64",
      "node20-macos-arm64",
      "node20-win-x64"
    ],
    "outputPath": "dist"
  }
}